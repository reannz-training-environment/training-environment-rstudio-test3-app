# Image for the test3 (RStudio) training environment app.
#
# Generated by training-environment-app-creator from apps/test3.yml in
# https://github.com/reannz-training-environment/training-environment-app-creator
# Change the app spec rather than this file: the next update from the app
# creator replaces it. Anything the spec cannot express can go in the spec's
# advanced.dockerfile.

FROM rocker/rstudio:4.5.3

# install system dependencies; ldap-utils, libnss-ldapd, libpam-ldapd, nscd and
# nslcd make the container resolve the training users from the environment's LDAP
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        bzip2 \
        ca-certificates \
        curl \
        dnsutils \
        file \
        git \
        jq \
        ldap-utils \
        less \
        libnss-ldapd \
        libpam-ldapd \
        nano \
        nodejs \
        nscd \
        nslcd \
        python3 \
        python3-dev \
        python3-pip \
        python3-venv \
        rsync \
        tree \
        unzip \
        vim \
        wget \
        xz-utils \
        zip \
    && rm -rf /var/lib/apt/lists/*

# Make sure RStudio uses the R this image was built on, whatever else is put
# on PATH later
RUN echo "rsession-which-r=/usr/local/bin/R" > /etc/rstudio/rserver.conf

# Python packages go in a virtual environment at the front of PATH: Ubuntu
# 24.04 does not let pip change the system Python, and pip cannot upgrade
# packages that apt installed there
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip --no-cache-dir install --upgrade pip 'setuptools>=64' wheel
ENV PATH="/opt/venv/bin:${PATH}"

# install kubectl, required for running on the k8s cluster
ARG KUBECTL_VERSION=v1.28.5
RUN curl -fsSLO https://dl.k8s.io/release/$KUBECTL_VERSION/bin/linux/amd64/kubectl \
    && mv kubectl /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl

# copy in ood k8s utils
# template/before.sh.erb sources find_host_port, save_passwd_as_secret and
# create_salt_and_sha1 from here to set up the connection details, so the app
# will not connect without them
ARG UTILS_HASH=6298fb01f7a7c66a8454e3f0fd74437a32491423
RUN git clone https://github.com/nesi/training-environment-k8s-utils.git /opt/ood-k8s-utils \
    && cd /opt/ood-k8s-utils \
    && git checkout $UTILS_HASH \
    && chmod +x /opt/ood-k8s-utils/files/* \
    && mv /opt/ood-k8s-utils/files/* /bin/ \
    && rm -rf /opt/ood-k8s-utils

# system packages requested in the app spec (docker/apt-packages.txt)
COPY apt-packages.txt /opt/app-creator/apt-packages.txt
RUN apt-get update \
    && xargs -a /opt/app-creator/apt-packages.txt env DEBIAN_FRONTEND=noninteractive apt-get install -y \
    && rm -rf /var/lib/apt/lists/*

# ---------------------------------------------------------------------------
# Lmod, so that `module avail` and `module load` work as they do on the cluster
#
# Modulefiles live in /opt/modulefiles. Login shells get `module` from
# /etc/profile.d, other interactive shells (VS Code's terminal) from
# /etc/bash.bashrc, and batch jobs and other scripts from BASH_ENV.
# ---------------------------------------------------------------------------
ARG LMOD_VERSION=8.7.55
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        bc \
        liblua5.3-dev \
        lua-bit32 \
        lua-filesystem \
        lua-filesystem-dev \
        lua-posix \
        lua-posix-dev \
        lua-term \
        lua5.3 \
        tcl \
        tcl-dev \
    && rm -rf /var/lib/apt/lists/* \
    && curl -fsSL "https://github.com/TACC/Lmod/archive/refs/tags/${LMOD_VERSION}.tar.gz" | tar -xz -C /tmp \
    && cd "/tmp/Lmod-${LMOD_VERSION}" \
    && ./configure --prefix=/opt \
    && make install \
    && cd / \
    && rm -rf "/tmp/Lmod-${LMOD_VERSION}" \
    && ln -s /opt/lmod/lmod/init/profile /etc/profile.d/z00_lmod.sh \
    && mkdir -p /opt/modulefiles \
    && printf '%s\n' '' \
        '# Lmod, for interactive shells that are not login shells (e.g. VS Code terminals)' \
        'if ! type module > /dev/null 2>&1; then . /opt/lmod/lmod/init/bash; fi' \
        >> /etc/bash.bashrc

ENV MODULEPATH=/opt/modulefiles \
    BASH_ENV=/opt/lmod/lmod/init/bash

# ---------------------------------------------------------------------------
# Emulated NVIDIA GPUs
#
# The emulator, gpuemu, comes from the NeSI GPU workshop app
# (https://github.com/nesi/training-environment-jupyter-gpu-app.git), pinned to v0.5.3.
# nvidia-smi, nvtop, NVML (pynvml), torch.cuda and the Slurm emulator's
# sbatch/squeue/seff all work against simulated cards. No physical GPU is
# involved: all computation runs on the CPU, so no timing measured in this
# image means anything about GPU performance.
# ---------------------------------------------------------------------------

# nvtop, built from source with only the NVIDIA backend: the apt package is too
# old to have the dlopen-based NVIDIA backend the emulator's NVML relies on
ARG NVTOP_VERSION=3.1.0
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y \
        build-essential \
        cmake \
        htop \
        libdrm-dev \
        libncurses-dev \
        pciutils \
        time \
    && git clone --depth 1 --branch "${NVTOP_VERSION}" https://github.com/Syllo/nvtop.git /tmp/nvtop \
    && mkdir -p /tmp/nvtop/build \
    && cd /tmp/nvtop/build \
    && cmake .. -DCMAKE_BUILD_TYPE=Release \
        -DNVIDIA_SUPPORT=ON \
        -DAMDGPU_SUPPORT=OFF \
        -DINTEL_SUPPORT=OFF \
        -DMSM_SUPPORT=OFF \
        -DPANFROST_SUPPORT=OFF \
        -DPANTHOR_SUPPORT=OFF \
        -DASCEND_SUPPORT=OFF \
        -DTPU_SUPPORT=OFF \
    && make -j"$(nproc)" \
    && make install \
    && cd / \
    && rm -rf /tmp/nvtop \
    && apt-get purge -y cmake \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# The Python side of the GPU stack; profile_plot draws Slurm job profiles with
# matplotlib. PyTorch is the CPU build: the CUDA build is far larger and
# could not run anyway; the emulator is what makes torch.cuda work.
RUN /opt/venv/bin/pip --no-cache-dir install nvidia-ml-py matplotlib numba \
    && /opt/venv/bin/pip --no-cache-dir install --index-url https://download.pytorch.org/whl/cpu torch torchvision

# Numba's CUDA simulator runs @cuda.jit kernels in the interpreter, so learners
# can write real CUDA kernels - threads, blocks, shared memory, syncthreads -
# and have them run correctly, if slowly
ENV NUMBA_ENABLE_CUDASIM=1

# The emulator. Its libnvidia-ml.so.1 goes on the loader path, so everything
# that looks for a GPU through NVML (nvtop, pynvml, ...) finds the emulated cards.
ARG GPUEMU_REPO=https://github.com/nesi/training-environment-jupyter-gpu-app.git
# v0.5.3
ARG GPUEMU_REF=690ff356463dbbd629daa79925c71bb4cf792328
RUN mkdir -p /tmp/gpu-app \
    && cd /tmp/gpu-app \
    && git init -q \
    && git fetch -q --depth 1 "${GPUEMU_REPO}" "${GPUEMU_REF}" \
    && git checkout -q FETCH_HEAD \
    && mkdir -p /opt/gpuemu \
    && mv docker/gpuemu /opt/gpuemu/src \
    && cd / \
    && rm -rf /tmp/gpu-app \
    && cd /opt/gpuemu/src/nvml \
    && make PREFIX=/opt/gpuemu install \
    && echo "/opt/gpuemu/lib" > /etc/ld.so.conf.d/gpuemu.conf \
    && ldconfig \
    && cd /opt/gpuemu/src \
    && /opt/venv/bin/pip --no-cache-dir install . \
    && install -m 0755 /opt/gpuemu/src/bin/nvidia-smi /usr/local/bin/nvidia-smi \
    && install -d /run/gpuemu /run/gpuemu/claims /run/gpuemu/slurm/jobs \
    && chmod 1777 /run/gpuemu /run/gpuemu/claims /run/gpuemu/slurm /run/gpuemu/slurm/jobs

# Check the emulator at build time rather than in front of a workshop: its own
# test suite, the NVML shim loading and enumerating a device, and a real
# @cuda.jit kernel running in the simulator.
RUN cd /opt/gpuemu/src \
    && /opt/venv/bin/pip --no-cache-dir install pytest pyyaml \
    && python3 -m pytest tests -q \
    && gpuemud --once \
    && nvidia-smi -L \
    && nvidia-smi \
    && seff -h | grep -q "Usage: seff" \
    && python3 -c "import ctypes; l=ctypes.CDLL('libnvidia-ml.so.1'); assert l.nvmlInit_v2()==0; n=ctypes.c_uint(); assert l.nvmlDeviceGetCount_v2(ctypes.byref(n))==0; assert n.value>=1, n.value; print('NVML shim OK')" \
    && python3 -c "\
import numpy as np; from numba import cuda;\
exec('@cuda.jit\ndef add(a,b,o):\n i=cuda.grid(1)\n if i<o.size: o[i]=a[i]+b[i]\n');\
a=np.arange(64,dtype=np.float32); b=a*2; o=np.zeros_like(a);\
add[2,32](a,b,o);\
assert np.allclose(o,a+b), o;\
print('numba cudasim OK')" \
    && /opt/venv/bin/pip --no-cache-dir uninstall -y pytest \
    && rm -rf /run/gpuemu/state.bin /opt/gpuemu/src/.pytest_cache

# Claim a device automatically when a process imports torch or numba.cuda, so
# a learner's code shows up in nvidia-smi without any boilerplate.
ENV GPUEMU_AUTOCLAIM=1 \
    GPUEMU_STATE_FILE=/run/gpuemu/state.bin \
    GPUEMU_CLAIMS_DIR=/run/gpuemu/claims \
    GPUEMU_SLURM_DIR=/run/gpuemu/slurm \
    GPUEMU_MEM_TOTAL=200MiB

# The node's cards, as name:memory. The learner chooses the card on the
# launch form, through submit.yml.erb; this is what a session gets without it.
ENV GPUEMU_FLEET=l4:200MiB

# The autoclaim hook goes in a .pth file, not sitecustomize.py: Ubuntu ships its
# own sitecustomize.py earlier on sys.path, which would silently shadow ours.
RUN SITEDIR="$(python3 -c 'import gpuemu, pathlib; print(pathlib.Path(gpuemu.__file__).parent.parent)')" \
    && printf '%s\n' \
        'try:' \
        '    from gpuemu.autoclaim import install as _install' \
        '    _install()' \
        'except Exception:' \
        '    pass' \
        > "${SITEDIR}/gpuemu_autostart.py" \
    && echo 'import gpuemu_autostart' > "${SITEDIR}/zz-gpuemu-autostart.pth" \
    && python3 -c "import sys; assert 'gpuemu_autostart' in sys.modules, 'the .pth did not run'"

# A banner, so anyone who opens a terminal knows the GPUs are emulated. Being
# quiet about that is the one genuinely harmful thing this image could do.
COPY scripts/gpu-banner.sh /etc/profile.d/gpuemu.sh
RUN chmod 0644 /etc/profile.d/gpuemu.sh \
    && printf '%s\n' '' \
        '# the emulated GPU banner, for terminals that are not login shells' \
        '[ -r /etc/profile.d/gpuemu.sh ] && . /etc/profile.d/gpuemu.sh' \
        >> /etc/bash.bashrc

# ---------------------------------------------------------------------------
# NeSI's own seff and svisit, from nesi/opt-nesi-bin (AGPL-3.0), in place of
# the emulator's look-alikes, so learners use the tools they will use on the
# cluster. scripts/slurm-nesi-tools.py teaches the Slurm emulator the sacct,
# squeue and srun options the two tools rely on. One site setting of seff is
# changed: the training environment counts cores, not hyperthreads.
# ---------------------------------------------------------------------------
ARG OPT_NESI_BIN_REPO=https://github.com/nesi/opt-nesi-bin.git
ARG OPT_NESI_BIN_REF=aa26eb44807d9b5073d73deb2f0d4fe0fc312762
COPY scripts/slurm-nesi-tools.py /opt/app-creator/slurm-nesi-tools.py
RUN SLURM_PY="$(python3 -c 'import gpuemu.slurm as s; print(s.__file__)')" \
    && cat /opt/app-creator/slurm-nesi-tools.py >> "${SLURM_PY}" \
    && python3 -m compileall -q "$(dirname "${SLURM_PY}")" \
    && BIN="$(dirname "$(command -v sbatch)")" \
    && mkdir -p /tmp/opt-nesi-bin \
    && cd /tmp/opt-nesi-bin \
    && git init -q \
    && git fetch -q --depth 1 "${OPT_NESI_BIN_REPO}" "${OPT_NESI_BIN_REF}" \
    && git checkout -q FETCH_HEAD \
    && sed -i '/^def partition_cpus_per_core/,/return/ s/return 2/return 1/' nn_seff \
    && grep -A1 '^def partition_cpus_per_core' nn_seff | grep -q 'return 1' \
    && install -m 0755 nn_seff "${BIN}/nn_seff" \
    && ln -sf nn_seff "${BIN}/seff" \
    && install -m 0755 svisit "${BIN}/svisit" \
    && install -d /usr/local/share/doc/opt-nesi-bin \
    && install -m 0644 LICENSE README.md /usr/local/share/doc/opt-nesi-bin/ \
    && echo "nn_seff (as seff) and svisit from ${OPT_NESI_BIN_REPO} at ${OPT_NESI_BIN_REF}; nn_seff's partition_cpus_per_core returns 1" \
        > /usr/local/share/doc/opt-nesi-bin/SOURCE \
    && cd / \
    && rm -rf /tmp/opt-nesi-bin

# ---------------------------------------------------------------------------
# Conda software requested in the app spec (docker/conda/environment.yml),
# installed with micromamba into one environment, /opt/conda/envs/apps.
#
# Every requested package becomes an environment module: `module load <name>`
# puts that package's commands, and nothing else, on PATH.
# ---------------------------------------------------------------------------
ARG MICROMAMBA_VERSION=2.8.1-1
ENV MAMBA_ROOT_PREFIX=/opt/conda
RUN curl -fsSL -o /usr/local/bin/micromamba \
        "https://github.com/mamba-org/micromamba-releases/releases/download/${MICROMAMBA_VERSION}/micromamba-linux-64" \
    && chmod 0755 /usr/local/bin/micromamba \
    && micromamba --version

COPY conda/ /opt/app-creator/conda/
COPY scripts/make-conda-wrappers.py /opt/app-creator/make-conda-wrappers.py

# The cleanup must run in this same RUN instruction: a later layer can hide a
# file but cannot reclaim the space it took in this one.
RUN micromamba create -y -p /opt/conda/envs/apps -f /opt/app-creator/conda/environment.yml \
    && micromamba clean --all --yes \
    && rm -rf /opt/conda/pkgs \
    && python3 /opt/app-creator/make-conda-wrappers.py \
        --prefix /opt/conda/envs/apps \
        --packages /opt/app-creator/conda/packages.txt \
        --mode lmod

# R packages requested in the app spec; the script fails the build if any of
# them cannot be loaded afterwards
COPY scripts/install-r-packages.R /opt/app-creator/install-r-packages.R
RUN Rscript /opt/app-creator/install-r-packages.R

# Python packages requested in the app spec (docker/requirements.txt)
COPY requirements.txt /opt/app-creator/requirements.txt
RUN /opt/venv/bin/pip --no-cache-dir install -r /opt/app-creator/requirements.txt

# Check every feature of this app at build time, so a broken image fails here
# rather than in front of a workshop (docker/scripts/smoke-test.sh)
COPY scripts/smoke-test.sh /opt/app-creator/smoke-test.sh
RUN bash /opt/app-creator/smoke-test.sh
